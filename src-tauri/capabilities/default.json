{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "updater:default",
    "process:default",
    "opener:allow-open-url"
  ]
}
